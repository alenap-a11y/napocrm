CREATE TABLE IF NOT EXISTS public.seances (
  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
  user_id      uuid REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,

  -- client (saisie libre, pas encore FK)
  client_prenom  text NOT NULL,
  client_nom     text NOT NULL,
  client_genre   text CHECK (client_genre IN ('Homme','Femme','Autre')),
  client_tel     text,
  client_email   text,

  -- séance
  date_seance    date NOT NULL,
  heure_seance   time NOT NULL,
  duree_minutes  int  NOT NULL DEFAULT 60,  -- ex: 60, 45, 90
  prix_euros     numeric(8,2),
  type_seance    text CHECK (type_seance IN (
                   'Sophrologie','Coaching','Naturopathie',
                   'Énergie','Fleurs de Bach','Autre'
                 )),

  -- observations
  notes          text,
  tags           text[],      -- ['Stress','Sommeil','Fatigue'…]

  -- schéma corporel
  schema_annotations  jsonb,  -- [{x,y,color,size,face:'Face'|'Dos'|'Côté'}]

  created_at  timestamptz DEFAULT now(),
  updated_at  timestamptz DEFAULT now()
);

-- index utiles
CREATE INDEX ON public.seances (user_id, date_seance DESC);
CREATE INDEX ON public.seances USING gin (tags);

-- RLS
ALTER TABLE public.seances ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Utilisateur voit ses séances"
  ON public.seances FOR ALL
  USING (auth.uid() = user_id)
  WITH CHECK (auth.uid() = user_id);

-- updated_at auto
CREATE OR REPLACE FUNCTION update_updated_at()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN NEW.updated_at = now(); RETURN NEW; END;
$$;

CREATE TRIGGER seances_updated_at
  BEFORE UPDATE ON public.seances
  FOR EACH ROW EXECUTE FUNCTION update_updated_at();
